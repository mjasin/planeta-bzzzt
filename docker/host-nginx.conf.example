# ═══════════════════════════════════════════════════════
# Szablon bloku serwera dla systemowego Nginx na VPS
# Umieść np. w /etc/nginx/sites-available/planeta-bzzzt
# i utwórz dowiązanie w /etc/nginx/sites-enabled/
# ═══════════════════════════════════════════════════════

server {
    server_name twoja-domena.pl www.twoja-domena.pl;

    # Nginx na hoście przekazuje ruch do kontenera Dockera:
    location / {
        proxy_pass http://127.0.0.1:8181;
        proxy_http_version 1.1;

        # Przekazywanie nagłówków klienta
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (na przyszłość / live reload)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # ── KRYTYCZNE DLA GODOTA: Przepuszczanie nagłówków COOP/COEP ──
        # Dzięki temu SharedArrayBuffer działa poprawnie w przeglądarce
        proxy_pass_header Cross-Origin-Opener-Policy;
        proxy_pass_header Cross-Origin-Embedder-Policy;
        proxy_pass_header Cross-Origin-Resource-Policy;
    }

    # Certbot doda tutaj automatycznie sekcje SSL po wykonaniu:
    # sudo certbot --nginx -d twoja-domena.pl
}
